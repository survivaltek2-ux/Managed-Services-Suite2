# Example Nginx configuration
#
# This serves three pre-built static frontend bundles directly and proxies
# /api/ to the Node API server. It assumes you have run `pnpm run build:deploy`
# and copied (or symlinked) the dist directories to /var/www/...
#
#   /var/www/siebert-services/public   <- artifacts/siebert-services/dist/public
#   /var/www/partner-portal/public     <- artifacts/partner-portal/dist/public
#   /var/www/connectors-portal/public  <- artifacts/connectors-portal/dist/public

upstream api_backend {
    server localhost:8080;
}

server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com;

    # Redirect HTTP to HTTPS (uncomment in production)
    # return 301 https://$server_name$request_uri;

    # Enable gzip compression
    gzip on;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;
    gzip_min_length 1000;

    # ---------------------------------------------------------
    # Partner Portal (mounted at /partners/)
    # ---------------------------------------------------------
    location /partners/ {
        alias /var/www/partner-portal/public/;
        try_files $uri $uri/ /partners/index.html;

        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 30d;
            add_header Cache-Control "public, immutable";
        }
    }

    # ---------------------------------------------------------
    # Referral Network / Connectors Portal (mounted at /referrals/)
    # ---------------------------------------------------------
    location /referrals/ {
        alias /var/www/connectors-portal/public/;
        try_files $uri $uri/ /referrals/index.html;

        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 30d;
            add_header Cache-Control "public, immutable";
        }
    }

    # ---------------------------------------------------------
    # API routes (proxied to Node)
    # ---------------------------------------------------------
    location /api/ {
        proxy_pass http://api_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_pass_header Authorization;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }

    # Health check endpoint
    location = /api/healthz {
        proxy_pass http://api_backend;
        access_log off;
    }

    # ---------------------------------------------------------
    # Main marketing site (mounted at /)
    # MUST come last so it catches everything not matched above.
    # ---------------------------------------------------------
    location / {
        root /var/www/siebert-services/public;
        try_files $uri $uri/ /index.html;

        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 30d;
            add_header Cache-Control "public, immutable";
        }
    }

    # Deny access to sensitive files
    location ~ /\. {
        deny all;
    }

    location ~ ~$ {
        deny all;
    }
}

# HTTPS configuration (uncomment and update for production)
# server {
#     listen 443 ssl http2;
#     server_name yourdomain.com www.yourdomain.com;
#
#     ssl_certificate /etc/letsencrypt/live/yourdomain.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/yourdomain.com/privkey.pem;
#
#     ssl_protocols TLSv1.2 TLSv1.3;
#     ssl_ciphers HIGH:!aNULL:!MD5;
#     ssl_prefer_server_ciphers on;
#
#     # [Include all location blocks from above]
# }
#
# server {
#     listen 80;
#     server_name yourdomain.com www.yourdomain.com;
#     return 301 https://$server_name$request_uri;
# }
