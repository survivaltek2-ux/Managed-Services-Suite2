# ============================================================
# Siebert Services — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ------------------------------------------------------------
# Database (required)
# PostgreSQL connection string
# ------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/siebert_services

# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------
NODE_ENV=production

# ------------------------------------------------------------
# API Server authentication (required)
# Change JWT_SECRET to a long random string in production
# ------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret

# Server port for the API (defaults to 8080)
PORT=8080

# Public base URL of the deployed app (used for outbound links in emails, etc.)
# PUBLIC_URL=https://yourdomain.com
# PARTNER_PORTAL_URL=https://yourdomain.com/partners

# ------------------------------------------------------------
# AI Chat Assistant (required for AI chat widget)
# Use your own OpenAI API key when hosting outside Replit
# ------------------------------------------------------------
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...

# ------------------------------------------------------------
# Email / SMTP (optional — gracefully degrades if not set)
# Used for deal submission and support ticket notifications
# ------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM_EMAIL=noreply@siebertservices.com
# SMTP_FROM_NAME=Siebert Services
# NOTIFICATION_EMAIL=admin@siebertservices.com

# ------------------------------------------------------------
# Microsoft SSO (optional — only needed for MS SSO login)
# ------------------------------------------------------------
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# MICROSOFT_REDIRECT_URI=https://yourdomain.com/api/auth/sso/microsoft/callback

# ------------------------------------------------------------
# Google Cloud Storage (optional — only needed if using object
# storage features: file uploads, lead-magnet PDFs, etc.)
#
# Off Replit, the app uses Google Application Default Credentials.
# Either set GOOGLE_APPLICATION_CREDENTIALS to a service-account
# JSON key file, or run on a GCP VM / Cloud Run with an attached
# service account, or `gcloud auth application-default login`.
# ------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# PUBLIC_OBJECT_SEARCH_PATHS=your-bucket/public
# PRIVATE_OBJECT_DIR=your-bucket/private

# ------------------------------------------------------------
# Partner / referral integrations (optional)
# ------------------------------------------------------------
# PARTNERSTACK_PUBLIC_KEY=
# PARTNERSTACK_SECRET_KEY=
# PARTNERSTACK_WEBHOOK_SECRET=
# IMPACT_ACCOUNT_SID=
# IMPACT_AUTH_TOKEN=

# ------------------------------------------------------------
# Stripe (optional — only needed for billing features)
# ------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CLIENT_ID=

# ------------------------------------------------------------
# Zoom (optional — only needed for Zoom Phone SMS / scheduling)
# ------------------------------------------------------------
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_PHONE_NUMBER=
# ZOOM_WS_SUBSCRIPTION_ID=

# ------------------------------------------------------------
# Google Places (optional — only needed for address autocomplete)
# ------------------------------------------------------------
# GOOGLE_PLACES_API_KEY=

# ------------------------------------------------------------
# Frontend build variables (set at build time, optional)
# Each web artifact has sensible defaults; override only if needed:
#   siebert-services:  PORT=3000, BASE_PATH=/
#   partner-portal:    PORT=3001, BASE_PATH=/partners/
#   connectors-portal: PORT=3002, BASE_PATH=/referrals/
# ------------------------------------------------------------
# BASE_PATH=/
